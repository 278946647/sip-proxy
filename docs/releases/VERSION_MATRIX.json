      "probes": [
        "opkg/manifest gfc-client == 1.1.0-r23 when OEM image claim",
        "grep GFC_VGA_CONSOLE_LAST target/linux/x86/image/Makefile",
        "zcat *combined*efi*.img.gz | strings | grep 'console=ttyS0.*console=tty1'"
      ],
      "notes": "Patch: ImmortalWrt 24.10 always appends ttyS0 last; inject console=tty1 after it (r22 GRUB_SERIAL was a no-op)."
