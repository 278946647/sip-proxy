{
  "schema_version": 1,
  "policy": {
    "upgrade": "same_major_only",
    "support_window_minors": 99,
    "forbid_retag": true,
    "require_changelog": true,
    "deploy_order_default": ["control_plane", "forward_node", "client"]
  },
  "product": {
    "current": "2.0.0",
    "major": 2,
    "ota_baseline": "1.1.0",
    "ota_baseline_notes": "Boxes without Runtime OTA must bootstrap via install.sh / OEM image, then use platform OTA. Cross-major 1.x→2.0.0 is firmware/manual (not Runtime OTA Patch)."
  },
  "releases": [
    {
      "version": "2.0.0",
      "status": "current",
      "git_tag": "v2.0.0",
      "released": "2026-08-25",
      "components": {
        "control_plane_api": "0.1.0",
        "node_agent": "0.3.1",
        "gfc_client": "2.0.0-r1",
        "client_proto": 1,
        "node_proto": 1
      },
      "floors": {
        "gfc_client": "2.0.0-r1",
        "node_agent": "0.3.0",
        "client_proto": 1,
        "node_proto": 1
      },
      "upgrade_path": {
        "from_any_in_major": true,
        "from_majors": [2],
        "bridge": "1.1.9",
        "migration_doc": "docs/releases/notes/v2.0.0.md"
      },
      "channels": {
        "client_runtime": "firmware",
        "dataplane_arch": "firmware"
      },
      "probes": [
        "opkg/manifest gfc-client == 2.0.0-r1 when OEM image claim",
        "docs/BYPASS_MODE.md exists",
        "nft list chain inet gfc output_mangle_route contains customer_hosts when proxy_mode=bypass",
        "git rev-parse v2.0.0"
      ],
      "notes": "Major / Dataplane-Arch: first shipping bypass Option B (device Web, public customer_hosts DNS). Default remains gateway. 1.x must go via v1.1.9 then firmware/manual — no same-major OTA hop to 2.0.0."
    },
