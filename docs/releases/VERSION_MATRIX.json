{
  "schema_version": 1,
  "policy": {
    "upgrade": "same_major_only",
    "support_window_minors": 99,
    "forbid_retag": true,
    "require_changelog": true,
    "deploy_order_default": ["control_plane", "forward_node", "client"]
  },
  "product": {
    "current": "1.1.0",
    "major": 1,
    "ota_baseline": "1.1.0",
    "ota_baseline_notes": "Boxes without Runtime OTA must bootstrap via install.sh / OEM image, then use platform OTA."
  },
  "releases": [
    {
      "version": "1.1.0",
      "status": "current",
      "git_tag": "v1.1.0",
      "released": "2026-07-16",
      "components": {
        "control_plane_api": "0.1.0",
        "node_agent": "0.3.1",
        "gfc_client": "1.1.0-r15",
        "client_proto": 1,
        "node_proto": 1
      },
      "floors": {
        "gfc_client": "1.1.0-r14",
        "node_agent": "0.3.0",
        "client_proto": 1,
        "node_proto": 1
      },
      "upgrade_path": {
        "from_any_in_major": true,
        "from_majors": [1],
        "bridge": null,
        "migration_doc": null
      },
      "channels": {
        "client_runtime": "ota",
        "dataplane_arch": "firmware"
      },
      "probes": [
        "GET /api/v1/upgrade/status on client",
        "POST /api/v1/diagnostics/vless includes expected_ip/socks_ip",
        "opkg/manifest gfc-client == 1.1.0-r15 when OEM image claim"
      ],
      "notes": "OTA phase-1 + device lifecycle + VLESS SOCKS-aware diagnostics baseline."
    }
  ]
}
