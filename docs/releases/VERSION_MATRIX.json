{
  "schema_version": 1,
  "policy": {
    "upgrade": "same_major_only",
    "support_window_minors": 99,
    "forbid_retag": true,
    "require_changelog": true,
    "deploy_order_default": ["control_plane", "forward_node", "client"]
  },
  "product": {
    "current": "1.1.5",
    "major": 1,
    "ota_baseline": "1.1.0",
    "ota_baseline_notes": "Boxes without Runtime OTA must bootstrap via install.sh / OEM image, then use platform OTA."
  },
  "releases": [
    {
      "version": "1.1.5",
      "status": "current",
      "git_tag": "v1.1.5",
      "released": "2026-07-20",
      "components": {
        "control_plane_api": "0.1.0",
        "node_agent": "0.3.1",
        "gfc_client": "1.1.0-r20",
        "client_proto": 1,
        "node_proto": 1
      },
      "floors": {
        "gfc_client": "1.1.0-r14",
        "node_agent": "0.3.0",
        "client_proto": 1,
        "node_proto": 1
      },
      "upgrade_path": {
        "from_any_in_major": true,
        "from_majors": [1],
        "bridge": null,
        "migration_doc": null
      },
      "channels": {
        "client_runtime": "ota",
        "dataplane_arch": "firmware"
      },
      "probes": [
        "opkg/manifest gfc-client == 1.1.0-r20 when OEM image claim",
        "ls bin/targets/x86/64/packages/kernel_* on build host before package/install",
        "opkg list-installed | grep kmod-tcp-bbr"
      ],
      "notes": "Patch: force kernel ipk refresh before package/install; drop Realtek oob + luci firewall i18n."
    },
