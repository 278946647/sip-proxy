# GFC control plane install parameters
# 非交互: sudo bash deploy/control/install-docker.sh --config deploy/control/install.env --yes

# 对外 API 地址（IP 或域名，写入客户端线路码）
CONTROL_PLANE_HOST=192.168.1.10
API_PORT=8080
# CONTROL_PLANE_HOST_FALLBACK=10.0.0.5

# 或直接写完整 URL（优先级更高）
# GFC_PUBLIC_URL=http://api.example.com:8080
# GFC_PUBLIC_URL_FALLBACK=http://192.168.1.10:8080
