# 转发节点安装参数（复制为 install.env 后修改，或 install.sh --config install.env）
# 安装完成后会同步写入 /etc/gfc-node/gfc.env 与 /etc/gfc-node/install.env

# --- 控制平台地址（主 + 备，支持 IP 或域名）---
# 方式 1：完整 URL（推荐）
SERVER_URL=http://api.example.com:8181
SERVER_URL_FALLBACK=http://192.168.1.10:8181

# 方式 2：主机 + 端口（IP 或域名均可）
# CONTROL_PLANE_HOST=api.example.com
# CONTROL_PLANE_HOST_FALLBACK=192.168.1.10
# API_PORT=8181

# 兼容旧变量名
# CONTROL_PLANE_IP=192.168.1.10
# CONTROL_PLANE_IP_FALLBACK=10.0.0.5

# 须与控制平台 API 的 GFC_BOOTSTRAP_TOKENS 一致
BOOTSTRAP_TOKEN=demo-bootstrap

# 控制台「转发节点」中显示的名称（可之后在 Web UI 改名）
NODE_NAME=MY-Node-01
REGION=ap-southeast-1

# 以太网直通模式：VyOS/客户流量「入向」网卡
# GFC_TPROXY_IFACE=eth0

# 默认出口 SNAT：auto = 自动读取「默认路由」网卡
GFC_SNAT_IFACE=auto

# 可选
# GFC_ROOT=/opt/gfc-node
# REPO_SRC=/var/socks-src/gfc-platform
# SINGBOX_VERSION=1.13.4
# POLL_SECONDS=10
