# GFC client offline / online install parameters
# Copy to install.env and edit before: sudo bash install.sh --config install.env

# Control plane (optional if line code JSON already contains server/servers)
# 主地址：域名或 IP 均可
# SERVER_URL=http://api.example.com:8080
# 备用地址：域名不可解析或内网直连时使用
# SERVER_URL_FALLBACK=http://192.168.1.10:8080
# 或逗号分隔多个：SERVER_URLS=http://api.example.com:8080,http://192.168.1.10:8080

# Base32 line code file on device (written by flash-line-code.sh)
ACTIVATION_FILE=/etc/gfc-client/activation.b32

# Device display name
DEVICE_NAME=gfc-box-001

# gateway | bypass | transparent
GFC_PROXY_MODE=gateway

# transparent: LAN interface to hijack; gateway: WAN for NAT (auto-detect if empty)
GFC_LAN_IFACE=eth1
GFC_WAN_IFACE=

GFC_ROOT=/opt/gfc-client
POLL_SECONDS=10

# Pinned binary versions (online install downloads if bin/ missing in offline tar)
SINGBOX_VERSION=1.13.4
MOSDNS_VERSION=5.3.3

# SSH reverse tunnel port reported to control plane (optional)
REVERSE_SSH_PORT=
