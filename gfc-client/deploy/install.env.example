GFC_ROOT=/opt/gfc-client
DEVICE_NAME=gfc-box-001
GFC_PROXY_MODE=gateway
GFC_POLICY_MARK=0x2023
GFC_POLICY_TABLE=2022
GFC_TUN_INTERFACE=gfctun
GFC_MOSDNS_UID=65353
GFC_SINGBOX_UID=65354
GFC_ROUTING_SCHEME=kernel-split
GFC_SSH_PORT=212
POLL_SECONDS=10
# Optional explicit relay node IP (also auto-loaded from config_bundle.json)
# GFC_NODE_BYPASS=103.78.41.15
# GFC_REVERSE_SSH_HOST=jump.example.com
# GFC_REVERSE_SSH_USER=root
# GFC_SSH_PORT_BASE=6000
# GFC_UPGRADE_MANIFEST_URL=https://example.com/gfc-client/manifest.json
GO_VERSION=1.22.10
NODE_VERSION=20.18.1
SINGBOX_VERSION=1.13.4
# Optional pin: MOSDNS_VERSION=5.3.4 (IrineSistiana/mosdns); default tries pmkol/mosdns-x first
SERVER_URL=
SERVER_URL_FALLBACK=
