#!/bin/sh
# Expand root partition + ext4 to fill the physical disk (uci-defaults one-shot).
# Runs before 97/98/99 so later OEM bring-up sees the final root size.
#
# Image PARTSIZE stays small for fast flash; leftover space after dd is claimed here.
# Failure must NOT block password / network / 99-gfc-firstboot → always exit 0.
#
# Requires packages: resize2fs (standalone; not e2fsprogs), parted, partx-utils (binary: partx).
LOG="/tmp/gfc-expand-rootfs.log"

exec >>"$LOG" 2>&1
echo "=== GFC expand-rootfs $(date -Iseconds 2>/dev/null || date) ==="

# Minimum free sectors (~8 MiB) before we bother resizing.
MIN_FREE_SECTORS=16384

resolve_root_dev() {
	local majmin sys name
	majmin="$(awk '$5 == "/" && $3 != "0:0" { print $3; exit }' /proc/self/mountinfo)"
	[ -n "$majmin" ] || return 1
	sys="$(readlink -f "/sys/dev/block/${majmin}" 2>/dev/null)" || return 1
	name="$(basename "$sys")"
	[ -b "/dev/${name}" ] || return 1
	printf '%s\n' "/dev/${name}"
}

disk_of_part() {
	# /sys/class/block/sda2 -> parent block name sda (also mmcblk0p2 -> mmcblk0)
	local part="$1" sys parent
	part="${part#/dev/}"
	sys="$(readlink -f "/sys/class/block/${part}" 2>/dev/null)" || return 1
	parent="$(basename "$(dirname "$sys")")"
	[ -b "/dev/${parent}" ] || return 1
	printf '%s\n' "/dev/${parent}"
}

part_num_of() {
	local part="$1"
	part="${part#/dev/}"
	[ -f "/sys/class/block/${part}/partition" ] || return 1
	cat "/sys/class/block/${part}/partition"
}

fs_of_mount() {
	awk '$2 == "/" { print $3; exit }' /proc/mounts
}

expand_root() {
	local root disk pnum start size disk_size free_end new_size i fs

	if ! command -v parted >/dev/null 2>&1; then
		echo "SKIP: parted not installed"
		return 1
	fi
	if ! command -v resize2fs >/dev/null 2>&1; then
		echo "SKIP: resize2fs not installed (need package resize2fs, not e2fsprogs alone)"
		return 1
	fi

	fs="$(fs_of_mount)"
	case "$fs" in
	ext2|ext3|ext4) ;;
	*)
		echo "SKIP: root fs is '${fs:-unknown}', only ext* supported"
		return 1
		;;
	esac

	root="$(resolve_root_dev)" || {
		echo "SKIP: cannot resolve root block device"
		return 1
	}
	disk="$(disk_of_part "$root")" || {
		echo "SKIP: cannot resolve parent disk for $root"
		return 1
	}
	pnum="$(part_num_of "$root")" || {
		echo "SKIP: $root is not a partition"
		return 1
	}

	start="$(cat "/sys/class/block/${root#/dev/}/start")"
	size="$(cat "/sys/class/block/${root#/dev/}/size")"
	disk_size="$(cat "/sys/class/block/${disk#/dev/}/size")"
	free_end=$((disk_size - start - size))

	echo "root=$root disk=$disk part=$pnum fs=$fs"
	echo "start=$start size=$size disk_size=$disk_size free_end=$free_end"

	if [ "$free_end" -lt "$MIN_FREE_SECTORS" ]; then
		echo "OK: already near full disk (free_end=${free_end} sectors)"
		return 0
	fi

	echo "parted resizepart $pnum 100%"
	parted -s "$disk" resizepart "$pnum" 100% || {
		echo "ERROR: parted resizepart failed"
		return 1
	}

	if command -v partx >/dev/null 2>&1; then
		partx -u "$disk" 2>/dev/null || true
	fi

	i=0
	while [ "$i" -lt 30 ]; do
		new_size="$(cat "/sys/class/block/${root#/dev/}/size" 2>/dev/null || echo 0)"
		if [ "$new_size" -gt "$size" ]; then
			echo "kernel sees new partition size=$new_size (was $size)"
			break
		fi
		i=$((i + 1))
		sleep 1
	done
	new_size="$(cat "/sys/class/block/${root#/dev/}/size" 2>/dev/null || echo 0)"
	if [ "$new_size" -le "$size" ]; then
		echo "WARN: kernel partition size unchanged; resize2fs may no-op until reboot"
	fi

	echo "resize2fs $root"
	resize2fs "$root" || {
		echo "ERROR: resize2fs failed"
		return 1
	}

	df -h / || true
	echo "OK: expand complete"
	return 0
}

if expand_root; then
	echo "GFC expand-rootfs done"
else
	echo "WARN: expand-rootfs skipped or failed (see log); continuing firstboot"
fi
# Always succeed so 97/98/99 still run.
exit 0
