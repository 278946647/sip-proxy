#!/bin/sh
# Align runtime inittab with OEM VGA policy (idempotent).
# - Do not use respawn on tty (causes "open: No such file" spam if tty missing)
# - Disable ttyS* / hvc* gettys on display-only appliances
set -eu
[ -f /etc/inittab ] || exit 0
sed -i -E \
	-e 's|^ttyS[0-9]+::|# &|' \
	-e 's|^hvc[0-9]+::|# &|' \
	/etc/inittab
sed -i 's|^tty1::respawn:|tty1::askfirst:|' /etc/inittab
if ! grep -qE '^tty1::' /etc/inittab; then
	echo 'tty1::askfirst:/usr/libexec/login.sh' >>/etc/inittab
fi
exit 0
