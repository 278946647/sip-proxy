#!/bin/sh
# Same-origin activation API proxy for port 80 (uhttpd CGI).
# Forwards to gfc-api on localhost without exposing admin token to the browser.
#
# Prefer curl: ImmortalWrt busybox wget often cannot POST JSON via --post-file=-
# (browser then shows generic "flash request failed").
set -eu

API="${GFC_API_URL:-http://127.0.0.1:8080/api/v1}"
TIMEOUT="${GFC_API_TIMEOUT:-15}"

print_headers() {
	printf 'Content-Type: application/json\r\n'
	printf 'Cache-Control: no-store\r\n'
	printf '\r\n'
}

json_error() {
	print_headers
	# Escape quotes/backslashes for minimal JSON safety.
	msg=$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g')
	printf '%s\n' "{\"ok\":false,\"error\":{\"message\":\"${msg}\"}}"
	exit 0
}

http_get() {
	url=$1
	if command -v curl >/dev/null 2>&1; then
		curl -sS -m "$TIMEOUT" "$url" 2>/dev/null && return 0
	fi
	wget -qO- -T "$TIMEOUT" "$url" 2>/dev/null && return 0
	return 1
}

http_post_json() {
	url=$1
	body=$2
	tmp=$(mktemp 2>/dev/null || echo /tmp/gfc-cgi-body.$$)
	printf '%s' "$body" >"$tmp"
	if command -v curl >/dev/null 2>&1; then
		# Do not use -f: API returns JSON body on 4xx (invalid code, etc.).
		curl -sS -m "$TIMEOUT" \
			-H 'Content-Type: application/json' \
			--data-binary @"$tmp" \
			"$url"
		rc=$?
		rm -f "$tmp"
		return "$rc"
	fi
	wget -qO- -T "$TIMEOUT" \
		--header='Content-Type: application/json' \
		--post-file="$tmp" \
		"$url"
	rc=$?
	rm -f "$tmp"
	return "$rc"
}

read_body() {
	if [ -n "${CONTENT_LENGTH:-}" ] && [ "$CONTENT_LENGTH" -gt 0 ] 2>/dev/null; then
		dd bs=1 count="$CONTENT_LENGTH" 2>/dev/null
	fi
}

case "${REQUEST_METHOD:-GET}" in
GET)
	ACTION="${QUERY_STRING#action=}"
	ACTION="${ACTION%%&*}"
	case "$ACTION" in
	status)
		print_headers
		http_get "$API/activation" \
			|| printf '{"ok":false,"error":{"message":"activation status unavailable (is gfc-api running on :8080?)"}}'
		;;
	health)
		print_headers
		http_get "$API/health" || printf '{"ok":false}'
		;;
	*)
		json_error "unknown action"
		;;
	esac
	;;
POST)
	BODY="$(read_body)"
	if [ -z "$BODY" ]; then
		json_error "empty body"
	fi
	print_headers
	if ! http_post_json "$API/activation/flash" "$BODY"; then
		printf '%s\n' '{"ok":false,"error":{"message":"flash request failed (gfc-api unreachable on 127.0.0.1:8080 — check /etc/init.d/gfc-api)"}}'
	fi
	;;
*)
	json_error "method not allowed"
	;;
esac
