{
  "luci-app-gfc": {
    "description": "Grant access to GFC local API helpers",
    "read": {
      "file": {
        "/usr/bin/wget": [ "exec" ],
        "/bin/busybox": [ "exec" ],
        "/bin/netstat": [ "exec" ],
        "/sbin/uci": [ "exec" ],
        "/sbin/ip": [ "exec" ],
        "/usr/sbin/nft": [ "exec" ],
        "/etc/init.d/gfc-api": [ "exec" ],
        "/etc/init.d/gfc-agent": [ "exec" ],
        "/etc/init.d/gfc-unbound": [ "exec" ],
        "/etc/init.d/gfc-sing-box": [ "exec" ],
        "/etc/init.d/gfc-routing": [ "exec" ],
        "/usr/bin/logread": [ "exec" ]
      }
    },
    "write": {
      "file": {
        "/usr/bin/wget": [ "exec" ],
        "/etc/init.d/gfc-api": [ "exec" ],
        "/etc/init.d/gfc-agent": [ "exec" ],
        "/etc/init.d/gfc-unbound": [ "exec" ],
        "/etc/init.d/gfc-sing-box": [ "exec" ],
        "/etc/init.d/gfc-routing": [ "exec" ]
      }
    }
  }
}
