#!/bin/sh
# OEM factory root password (uci-defaults one-shot).
# busybox OpenWrt often has passwd but not chpasswd — try both.
set -eu

OEM_ROOT_PASSWORD='Wgh@125434'

set_root_password() {
	local pw="$1"
	if command -v chpasswd >/dev/null 2>&1; then
		echo "root:${pw}" | chpasswd && return 0
	fi
	if command -v passwd >/dev/null 2>&1; then
		printf '%s\n%s\n' "$pw" "$pw" | passwd root >/dev/null 2>&1 && return 0
	fi
	# Last resort: busybox crypt via awk is unavailable; fail visibly.
	echo "ERROR: neither chpasswd nor passwd available" >&2
	return 1
}

if set_root_password "$OEM_ROOT_PASSWORD"; then
	echo "GFC OEM: root password set"
	exit 0
fi
echo "WARN: failed to set root password" >&2
# Non-zero → OpenWrt retries this uci-defaults on next boot.
exit 1
