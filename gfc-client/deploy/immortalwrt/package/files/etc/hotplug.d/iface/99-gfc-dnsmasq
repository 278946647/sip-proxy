#!/bin/sh
# Restart dnsmasq when LAN is ready so DHCP works on first client connect.
# OpenWrt may start dnsmasq before br-lan exists; a later ifup must rebind.
LOG="/tmp/gfc-dnsmasq-hotplug.log"

case "${ACTION:-}" in
ifup|ifupdate) ;;
*) exit 0 ;;
esac

# UCI interface name is "lan"; device is usually br-lan.
case "${INTERFACE:-}" in
lan) ;;
*)
	case "${DEVICE:-}" in
	br-lan) ;;
	*) exit 0 ;;
	esac
	;;
esac

[ -x /etc/init.d/dnsmasq ] || exit 0

echo "$(date -Iseconds 2>/dev/null || date) ACTION=$ACTION INTERFACE=$INTERFACE DEVICE=$DEVICE → dnsmasq restart" >>"$LOG"
/etc/init.d/dnsmasq restart >>"$LOG" 2>&1 || true
nft delete table inet dnsmasq 2>/dev/null || true
exit 0
