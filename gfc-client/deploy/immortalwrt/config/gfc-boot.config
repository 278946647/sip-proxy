# GFC OEM boot / GRUB (x86) — merge into ImmortalWrt .config (never defconfig after).
#
# Default ImmortalWrt enables GRUB serial + VGA. Kernel cmdline becomes:
#   console=tty1 console=ttyS0,115200n8
# Linux uses the *last* console= as /dev/console, so login/askfirst goes to
# serial. VMware VGA then looks "stuck" at "Run /sbin/init" (printk only).
#
# OEM appliances (VMware + physical display): VGA-only console.
# Headless serial-only boxes: re-enable CONFIG_GRUB_SERIAL=y in local .config.

CONFIG_GRUB_CONSOLE=y
# CONFIG_GRUB_SERIAL is not set
CONFIG_GRUB_TIMEOUT=5
