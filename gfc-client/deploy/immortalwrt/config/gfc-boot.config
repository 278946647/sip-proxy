# VGA /dev/console for ImmortalWrt 24.10+ x86.
#
# CRITICAL (24.10): target/linux/x86/image/Makefile *unconditionally* appends
#   console=$(CONFIG_TARGET_SERIAL)   # default ttyS0
# There is NO CONFIG_GRUB_SERIAL anymore. Setting "# CONFIG_GRUB_SERIAL is not set"
# is a no-op — r22's approach did not change grub.cfg.
#
# Linux uses the *last* console= as /dev/console. Stock cmdline ends in ttyS0 →
# VGA looks stuck after "Run /sbin/init" (VMware + bare metal with monitor).
#
# Fix: rebuild patches that Makefile so console=tty1 is appended *after* serial.
# Also: CONFIG_GRUB_CONSOLE=y, GRUB_TIMEOUT=5, tty1 inittab respawn.

CONFIG_GRUB_CONSOLE=y
CONFIG_GRUB_TIMEOUT=5
CONFIG_TARGET_SERIAL="ttyS0"
