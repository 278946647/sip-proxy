# GFC OEM firmware — merge into ImmortalWrt .config (never run make defconfig/oldconfig after).
#
# =============================================================================
# r16 service baseline (必要) vs OEM package source
# =============================================================================
# Compare: `service` on a golden r16 box. After disabling default-settings/fw4,
# packages that used to ride along MUST be selected explicitly below.
#
# init.d                 | needed | package / notes
# -----------------------|--------|------------------------------------------
# boot/done/umount/...   | yes    | base-files (always in image)
# network / sysntpd /    | yes    | base-files + busybox / netifd
#   log / cron / system  |        |
# dnsmasq                | yes    | dnsmasq-full
# dropbear               | yes    | dropbear  (was lost without default-settings)
# odhcpd                 | yes    | odhcpd-ipv6only (init still named odhcpd)
# uhttpd / rpcd /        | yes    | uhttpd + rpcd (+ luci-base)
#   ucitrack             |        | luci-base / luci-mod-admin-full
# autossh                | yes    | autossh (+ openssh-client for reverse SSH)
# gfc-agent/api/unbound/ | yes    | gfc-client package files
#   sing-box/routing/    |        |
#   lan-dhcp             |        |
# gfc-reverse-ssh        | dyn    | written by gfc-agent when platform opens tunnel
# sing-box / unbound     | yes    | stock daemons; GFC uses gfc-* wrappers
# firewall               | no     | firewall4 DISABLED (GFC owns nft)
# unbound (stock)        | no     | must stay disabled; gfc-unbound owns :53
# autocore/gpio/led/     | no     | ImmortalWrt x86 cosmetics — optional
#   lm-sensors/sysfsutils|        | not required for GFC dataplane
#   packet_steering      |        |
# =============================================================================

# Core GFC
CONFIG_PACKAGE_gfc-client=y
CONFIG_PACKAGE_luci-app-gfc=y
CONFIG_PACKAGE_luci-base=y

# Data plane (nftables: OpenWrt has nftables-json / nftables-nojson, not "nftables")
CONFIG_PACKAGE_sing-box=y
CONFIG_PACKAGE_unbound-daemon=y
CONFIG_PACKAGE_unbound-checkconf=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-nft-core=y
CONFIG_PACKAGE_nftables-json=y
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_libcap=y
CONFIG_PACKAGE_libcap-bin=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_tc-tiny=y
# sch_htb lives in kmod-sched-core (no Package: kmod-sched-htb on modern OpenWrt)
CONFIG_PACKAGE_kmod-sched-core=y
CONFIG_PACKAGE_kmod-ifb=y
# TCP BBR (+ sch_fq in kmod-sched)
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_kmod-sched=y

# Remote ops + SSH (r16: dropbear + autossh + reverse tunnel client)
CONFIG_PACKAGE_autossh=y
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_openssh-client=y
CONFIG_PACKAGE_openssh-keygen=y

# LuCI / portal HTTP (r16: uhttpd + rpcd running)
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_rpcd=y

# LAN IPv6 RA (r16: odhcpd running; OpenWrt package name is odhcpd-ipv6only)
CONFIG_PACKAGE_odhcpd-ipv6only=y

# Scene / ops tools (HANDOFF §6.4)
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_iftop=y
CONFIG_PACKAGE_bmon=y

# First-boot rootfs expand (fill unused disk after dd of fixed PARTSIZE image).
# OpenWrt ships resize2fs as its OWN package — NOT inside e2fsprogs.
# partx binary lives in package partx-utils (not "partx").
# parted is from the packages feed (make target: package/feeds/packages/parted).
# losetup: used by wiki-style rootfs resize fallback.
CONFIG_PACKAGE_resize2fs=y
CONFIG_PACKAGE_parted=y
CONFIG_PACKAGE_partx-utils=y
CONFIG_PACKAGE_losetup=y

# LuCI without ImmortalWrt meta "luci" (that meta pulls firewall4 → kmod-nft-fullcone).
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-mod-admin-full=y

# ImmortalWrt stock extras — disable for GFC OEM (merge script also force-scrubs these).
# GFC owns nft via gfc-routing; firstboot already stops fw4. fullcone is not in GFC architecture.
# Out-of-tree Realtek kmods often pin a stale vermagic and break package/install.
# CONFIG_PACKAGE_default-settings is not set
# CONFIG_PACKAGE_default-settings-chn is not set
# CONFIG_PACKAGE_kmod-nft-fullcone is not set
# CONFIG_PACKAGE_firewall4 is not set
# CONFIG_PACKAGE_luci-app-firewall is not set
# CONFIG_PACKAGE_luci is not set
# CONFIG_PACKAGE_luci-light is not set
# CONFIG_PACKAGE_luci-ssl is not set
# CONFIG_PACKAGE_luci-i18n-firewall-zh-cn is not set
# CONFIG_PACKAGE_kmod-r8168 is not set
# CONFIG_PACKAGE_kmod-r8101 is not set
# CONFIG_PACKAGE_kmod-r8125 is not set
# CONFIG_PACKAGE_kmod-r8126 is not set
# CONFIG_PACKAGE_kmod-usb-net-rtl8152-vendor is not set
