# GFC OEM firmware — merge into ImmortalWrt .config (never run make defconfig/oldconfig after).
# Invalid CONFIG_PACKAGE_* lines (package not in Kconfig) are stripped by setup/rebuild scripts.
#
# Core GFC
CONFIG_PACKAGE_gfc-client=y
CONFIG_PACKAGE_luci-app-gfc=y
CONFIG_PACKAGE_luci-base=y

# Data plane (required for GFC box)
CONFIG_PACKAGE_sing-box=y
CONFIG_PACKAGE_unbound-daemon=y
CONFIG_PACKAGE_unbound-checkconf=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_libcap-bin=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ip-full=y

# Remote ops
CONFIG_PACKAGE_autossh=y

# Scene / ops tools (HANDOFF §6.4)
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_iftop=y
CONFIG_PACKAGE_bmon=y
