# Merge into ImmortalWrt .config after target selection (make defconfig).
# Do NOT run "make defconfig" after merging — use: scripts/setup-immortalwrt-feed.sh merge-config
#
# Runtime stack (also selected here so package/install lists them even when not in gfc-client DEPENDS).
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_libcap-bin=y
CONFIG_PACKAGE_sing-box=y
CONFIG_PACKAGE_unbound-daemon=y
CONFIG_PACKAGE_unbound-checkconf=y
CONFIG_PACKAGE_autossh=y
CONFIG_PACKAGE_gfc-client=y
CONFIG_PACKAGE_luci-app-gfc=y
